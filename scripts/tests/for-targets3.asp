# Use empty sequences as the source and target of for statements.

for () in ():
    print()
print('---')
for [] in []:
    print()
print('---')
for () in []:
    print()
print('---')
for [] in ():
    print()
print('---')

for () in ..0:
    print()
print('---')
for [] in ..0:
    print()
print('---')
